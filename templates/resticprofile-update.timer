# {{ ansible_managed }}

[Unit]
Description="Update resticprofile timer"

[Timer]
Unit=resticprofile-update.service
OnCalendar={{ resticprofile_update_time }}
{% if resticprofile_update_randomized_delay != "" %}
RandomizedDelaySec={{ resticprofile_update_randomized_delay }}
{% endif %}
Persistent=true

[Install]
WantedBy=timers.target
